<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!--Bow Base-->
	<ThingDef Name="ABYautja_SimpleRanged" Abstract="True" ParentName="BaseWeapon">
		<techLevel>Neolithic</techLevel>
		<thingCategories Inherit="false">
			<li>WeaponsRanged</li>
			<li>ABYautja_RangedWeapons</li>
		</thingCategories>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<recipeUsers>
				<li>ABYautja_TableMachining</li>
			</recipeUsers>
			<researchPrerequisite>ABYautja_Tech_T1</researchPrerequisite>
			<effectWorking>Smelt</effectWorking>
			<unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
			<defaultIngredientFilter>
				<categories>
					<li>Root</li>
				</categories>
				<disallowedThingDefs>
					<li>Silver</li>
					<li>Gold</li>
					<li>Jade</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>
		</recipeMaker>
		<weaponTags>
			<li>YautjaRanged</li>
		</weaponTags>
		<tradeTags>
			<li>ABYautjaRanged</li>
		</tradeTags>
	</ThingDef>

<!--Gun Bases-->	
	<ThingDef Name="ABYautja_BaseGun" Abstract="True" ParentName="BaseWeapon">
		<smeltable>true</smeltable>
		<relicChance>1</relicChance>
		<thingCategories Inherit="false">
			<li>WeaponsRanged</li>
			<li>ABYautja_RangedWeapons</li>
		</thingCategories>
		<weaponClasses>
			<li>Ranged</li>
		</weaponClasses>
		<inspectorTabs>
			<li>ITab_Art</li>
		</inspectorTabs>
		<comps>
		  <li>
			<compClass>CompQuality</compClass>
		  </li>
		  <li Class="CompProperties_Art">
			<nameMaker>NamerArtWeaponGun</nameMaker>
			<descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
			<minQualityForArtistic>Excellent</minQualityForArtistic>
		  </li>
		</comps>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<recipeUsers>
				<li>ABYautja_TableMachining</li>
			</recipeUsers>
			<effectWorking>Smelt</effectWorking>
			<unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
			<defaultIngredientFilter>
				<categories>
					<li>Root</li>
				</categories>
				<disallowedThingDefs>
					<li>Silver</li>
					<li>Gold</li>
					<li>Jade</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>
		</recipeMaker>
		<weaponTags>
			<li>YautjaGun</li>
		</weaponTags>
		<tradeTags>
			<li>ABYautjaGuns</li>
		</tradeTags>
	</ThingDef>
	
	<ThingDef Name="ABYautja_BaseMakeableGun" ParentName="ABYautja_BaseGun" Abstract="True">
		<techLevel>Medieval</techLevel>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_T2</researchPrerequisite>
		</recipeMaker>
		<researchPrerequisites>
			<li>Smithing</li>
		</researchPrerequisites>
	</ThingDef>
	
	<ThingDef Name="ABYautja_BaseMakeableGun_T3" ParentName="ABYautja_BaseMakeableGun" Abstract="True">
		<techLevel Inherit ="False">Industrial</techLevel>
		<recipeMaker>
			<researchPrerequisite Inherit ="False">ABYautja_Tech_T3</researchPrerequisite>
		</recipeMaker>
	</ThingDef>
	
	<ThingDef Name="ABYautja_BaseMakeableGun_Tracking" ParentName="ABYautja_BaseMakeableGun_T3" Abstract="True">
		<recipeMaker>
			<researchPrerequisite Inherit ="False">ABYautja_Tech_Tracking</researchPrerequisite>
		</recipeMaker>
	</ThingDef>
	
	<ThingDef Name="ABYautja_BaseMakeableGun_PlasmaEnergy" ParentName="ABYautja_BaseMakeableGun_T3" Abstract="True">
		<techLevel Inherit ="False">Spacer</techLevel>
		<recipeMaker>
			<researchPrerequisite Inherit ="False">ABYautja_Tech_PlasmaEnergy</researchPrerequisite>
		</recipeMaker>
	</ThingDef>
	
	<ThingDef Name="ABYautja_BaseMakeableGun_T4" ParentName="ABYautja_BaseMakeableGun_PlasmaEnergy" Abstract="True">
		<recipeMaker>
			<researchPrerequisite Inherit ="False">ABYautja_Tech_T4</researchPrerequisite>
		</recipeMaker>
	</ThingDef>

<!--Melee Bases-->
	<ThingDef Name="ABYautja_BaseMeleeWeapon" Abstract="True" ParentName="BaseWeapon">
