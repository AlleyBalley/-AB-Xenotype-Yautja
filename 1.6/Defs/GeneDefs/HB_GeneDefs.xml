<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <GeneDef ParentName="ABYautjaMandibles_Base">
        <defName>HBBiohazardMandibles</defName>
        <label>Yautja Biohazard Mandibles</label>
        <description>A finger-like digit that sprouts from the cheekbone and possesses a sharp tooth. This array appears in a set of three with a mandible anchored to each cheekbone and a single, larger mandible placed in the center of the jawbone.</description>
        <iconPath>UI/Icons/Genes/Mandibles/HBBiohazardMandiblesIcon</iconPath>
        <renderNodeProperties>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPath>Things/Pawn/Humanlike/HeadAttachments/ComboMandibles/HBBiohazardMandibles</texPath>
				<parentTagDef>Head</parentTagDef>
				<overrideMeshSize>(0.6, 0.6)</overrideMeshSize>
				<drawSize>0.85</drawSize>
				<color>(255, 255, 255)</color>
				<visibleFacing>
					<li>East</li>
					<li>South</li>
					<li>West</li>
				</visibleFacing>
				<drawData>
					<defaultData>
						<layer>56</layer>
					</defaultData>
				</drawData>
			</li>
        </renderNodeProperties>
		<exclusionTags>
		<!-- No clipping with regular upper, regular lower, superior upper, superior lower -->
			<li>HBTriadMandibles</li> <!-- Spotlight mandible exclusion tag-->
			<li>ABUpperMandibles</li> <!-- Upper mandible exclusion tag-->
			<li></li>
		</exclusionTags>
		<modExtensions MayRequire="oskarpotocki.vanillafactionsexpanded.core">
			<li Class="VEF.Genes.GeneExtension">
				<backgroundPathEndogenes>UI/Icons/Genes/Yautja_Endogene_Background</backgroundPathEndogenes>
				<hediffsToBodyParts>
					<li>
						<hediff>HBYautjaComboMandibles</hediff>
						<bodyparts>
							<li>Jaw</li>
						</bodyparts>
					</li>
				</hediffsToBodyParts>
			</li>
		</modExtensions>
    </GeneDef>

<!-- =======================================================SCOOPTOOTH============================================================ -->

    <GeneDef ParentName="ABYautjaMandibles_Base">
        <defName>HBSpotlightMandible</defName>
        <label>Yautja Spotlight Mandible</label>
        <description>A finger-like digit that usually sprouts from the cheekbone, possessing a sharp tooth. This lonely apprendage is anchored to the jawbone. While it certainly is large and pointy, it admittedly looks kind of silly by itself. One is the loneliest number, after all.</description>
        <iconPath>UI/Icons/Genes/Mandibles/HBSpotlightMandibleIcon</iconPath>
        <renderNodeProperties>
			<li>
				<nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
				<workerClass>PawnRenderNodeWorker_FlipWhenCrawling</workerClass>
				<texPath>Things/Pawn/Humanlike/HeadAttachments/SpotlightMandible/HBSpotlightMandible</texPath>
				<parentTagDef>Head</parentTagDef>
				<overrideMeshSize>(0.6, 0.6)</overrideMeshSize>
				<drawSize>0.85</drawSize>
				<color>(255, 255, 255)</color>
				<visibleFacing>
					<li>East</li>
					<li>South</li>
					<li>West</li>
				</visibleFacing>
				<drawData>
					<defaultData>
						<layer>54</layer>
					</defaultData>
				</drawData>
			</li>
        </renderNodeProperties>
		<exclusionTags>
		<!-- No clipping with regular upper, regular lower, superior upper, superior lower -->
			<li>HBTriadMandibles</li> <!-- Biohazard mandible exclusion tag-->
			<li></li>
			<li></li>
		</exclusionTags>
		<modExtensions MayRequire="oskarpotocki.vanillafactionsexpanded.core">
			<li Class="VEF.Genes.GeneExtension">
				<backgroundPathEndogenes>UI/Icons/Genes/Yautja_Endogene_Background</backgroundPathEndogenes>
				<hediffsToBodyParts>
					<li>
						<hediff>HBYautjaLowerMandible</hediff>
						<bodyparts>
							<li>Jaw</li>
						</bodyparts>
					</li>
				</hediffsToBodyParts>
			</li>
		</modExtensions>
	</GeneDef>
</Defs>