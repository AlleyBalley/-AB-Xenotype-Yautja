<Defs>
<!--Ranged-->
	<ThingDef ParentName="ABYautja_BaseMakeableGun">
		<defName>ABYautja_Gun_Bolt</defName>
		<label>bolt gun</label>
		<description>Regardless of the exact form of the weapon, all bolt guns serve as projectile weapons firing a hail of razor thin metal spears. How these projectiles are fired is not clear, as the weapon produces no discernible muzzle flash and often little noise, yet fires these needles with tremendous velocity and accuracy. Regardless of physical appearance, the bolt guns is mid-ranged and powerful.\n\nThey are made from an unknown metal that is incredibly lightweight yet able to cut like hardened steel. They spears often have a blood groove down the middle, designed to cause a target to bleed out if they become stuck in the flesh.</description>
		<graphicData>
			<texPath>Things/Equipment/Ranged/Yautja_Boltgun</texPath>
			<graphicClass>Graphic_Single</graphicClass>	
			<shaderType>CutoutComplex</shaderType>
			<drawSize>0.95</drawSize>	
		</graphicData>
		<equippedAngleOffset>-15</equippedAngleOffset>
		<soundInteract>Interact_Autopistol</soundInteract>
		<statBases>
			<WorkToMake>3000</WorkToMake>
			<MarketValue>500</MarketValue>
			<Mass>1.5</Mass>
			<AccuracyTouch>0.75</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.50</AccuracyMedium>
			<AccuracyLong>0.35</AccuracyLong>
			<RangedWeapon_Cooldown>1.25</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>ABBullet_Boltgun</defaultProjectile>
				<warmupTime>1</warmupTime>
				<range>14</range>
				<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>5</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>5</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<weaponTags>
			<li>YautjaBoltGun</li>
		</weaponTags>
		<costStuffCount>40</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costList>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<modExtensions>
			<li Class="VEF.Things.ThingDefExtension">
				<weaponCarryDrawOffsets>
					<north>
						<drawOffset>(0.02, 0, -0.095)</drawOffset>
					</north>
					<east>
						<drawOffset>(0, 0, -0.095)</drawOffset>
					</east>
					<south>
						<drawOffset>(0.02, 0, -0.095)</drawOffset>
					</south>
					<west>
						<drawOffset>(0, 0, -0.095)</drawOffset>
					</west>
				</weaponCarryDrawOffsets>
			</li>
		</modExtensions>
	</ThingDef>
	
