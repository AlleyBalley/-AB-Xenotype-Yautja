<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!--Ranged-->
	<ThingDef ParentName="ABYautja_BaseMakeableGun_PlasmaEnergy">
		<defName>ABYautja_Gun_HandheldPlasmacaster</defName>
		<label>handheld plasmacaster</label>
		<description>The handheld plasmacaster is a handheld version of the shoulder mounted Plasmacaster.</description>
		<graphicData>
			<texPath>Things/Equipment/Ranged/Handheld_PredatorPlasmacaster</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>0.9</drawSize>
		</graphicData>
		<equippedAngleOffset>-10</equippedAngleOffset>
		<soundInteract>Interact_Autopistol</soundInteract>
		<statBases>
			<WorkToMake>20000</WorkToMake>
			<MarketValue>800</MarketValue>
			<Mass>2</Mass>
			<AccuracyTouch>0.80</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.60</AccuracyMedium>
			<AccuracyLong>0.35</AccuracyLong>
			<RangedWeapon_Cooldown>1.35</RangedWeapon_Cooldown>
		</statBases>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_PlasmaEnergy</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>ABBullet_Plasma</defaultProjectile>
				<warmupTime>1</warmupTime>
				<range>13</range>
				<soundCast>ABShot_ShoulderCannon</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>8</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>grip</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>6</power>
				<cooldownTime>1.6</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>6</power>
				<cooldownTime>1.6</cooldownTime>
			</li>
		</tools>
		<techLevel>Spacer</techLevel>
		<weaponTags>
			<li>YautjaHandheldPlasmacaster</li>
		</weaponTags>
		<costStuffCount>40</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costList>				
			<Plasteel>40</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<modExtensions>
			<li Class="VEF.Things.ThingDefExtension">
				<weaponCarryDrawOffsets>
					<north>
						<drawOffset>(0, 0, -0.05)</drawOffset>
					</north>
					<east>
						<drawOffset>(0, 0, -0.05)</drawOffset>
					</east>
					<south>
						<drawOffset>(0, 0, -0.05)</drawOffset>
					</south>
					<west>
						<drawOffset>(0, 0, -0.05)</drawOffset>
					</west>
				</weaponCarryDrawOffsets>
			</li>
		</modExtensions>
	</ThingDef>
	
