			</li>
			<li Class="PatchOperationRemove">
				<xpath>Defs/ThingDef[@Name="ABYautjaHeavyTurretBase"]/comps/li[@Class="CompProperties_Explosive"]</xpath>
			</li>
		</operations>
	</Operation>
	
