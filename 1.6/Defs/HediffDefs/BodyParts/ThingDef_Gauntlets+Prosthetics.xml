<!--Wood-->
	<ThingDef ParentName="CombineProstheticandGauntlet_TribalBase">
		<defName>WoodLogWithGauntlet_TribalGauntlet</defName>
		<label>wooden limb with wooden gauntlet</label>
		<description>An installed wooden limb complete with a wooden hand. Has a wooden gauntlet attached.</description>
		<techLevel>Neolithic</techLevel>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_TribalGauntlet</ThingDef>
			<HediffDef>ABYautja_WoodLog_TribalGauntlet</HediffDef>
			<RecipeDef>Install_WoodLogWithGauntlet_TribalGauntlet</RecipeDef>
		</descriptionHyperlinks>
		<costList>
			<ABYautja_TribalGauntlet>1</ABYautja_TribalGauntlet>
			<WoodLog>1</WoodLog>
		</costList>
		<statBases>
			<MarketValue>1001.2</MarketValue>
			<MaxHitPoints>250</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<Beauty>-3</Beauty>
			<DeteriorationRate>0.15</DeteriorationRate>
			<Mass>0.55</Mass>
		</statBases>
		<recipeMaker>
			<recipeUsers Inherit="False">
				<li>CraftingSpot</li>
				<li MayRequire="oskarpotocki.vfe.classical">VFEC_CraftingBench</li>
			</recipeUsers>
		</recipeMaker>
	</ThingDef>
	
