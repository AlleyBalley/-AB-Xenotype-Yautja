<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!--Blood-->
	<GeneDef>
		<defName>ABYautja_GreenBlood</defName>
		<label>yautja blood</label>
		<labelShortAdj>green blooded</labelShortAdj>
		<displayCategory>ABYautjaCategory</displayCategory>
		<biostatCpx>0</biostatCpx>
		<biostatMet>0</biostatMet>
		<iconPath>UI/Icons/Genes/Innards/Gene_GreenBlood</iconPath>
		<displayOrderInCategory>7902</displayOrderInCategory>
		<customEffectDescriptions MayRequire="ebsg.framework">
			<li>Carriers of this gene have neon green blood.</li>
		</customEffectDescriptions>
		<exclusionTags>
			<li>AG_BloodType</li>
			<li>BloodType</li>
			<li>Blood</li>
		</exclusionTags>
		<modExtensions MayRequire="oskarpotocki.vanillafactionsexpanded.core">
			<li Class="VEF.Genes.GeneExtension">
				<backgroundPathEndogenes>UI/Icons/Genes/Yautja_Endogene_Background</backgroundPathEndogenes>
				<customBloodThingDef>ABYautja_FilthBlood</customBloodThingDef>
				<customBloodSmearThingDef>ABYautja_FilthBloodSmear</customBloodSmearThingDef>
				<customBloodIcon>UI/Icons/Medical/Yautja_Bleeding</customBloodIcon>
				<customBloodEffect>Damage_HitABYautja</customBloodEffect>
				<customWoundsFromFleshtype>ABYautja_GreenWounds</customWoundsFromFleshtype>
			</li>
		</modExtensions>
	</GeneDef>
	<!--Green Veins-->
