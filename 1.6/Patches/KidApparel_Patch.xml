			<li>Toddlers</li>
		</mods>
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[defName="ABYautja_KidApparel_ThermalMesh" or defName="ABYautja_KidApparel_AdvancedThermalMesh"]/apparel/developmentalStageFilter</xpath>
