<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<RecipeDef ParentName="CombineWristbladeRecipe_Base">
		<defName>Make_ABYautja_DualWristblades</defName>
		<label>pair two wristblades</label>
		<description>pair two wristblades.</description>
		<jobString>Pair two wristblades.</jobString>
		<workAmount>10</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ABYautja_Wristblade</li>
					</thingDefs>
				</filter>
				<count>2</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
