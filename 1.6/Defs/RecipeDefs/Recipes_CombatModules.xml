<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--wristblade launcher-->
	<RecipeDef ParentName="GauntletModuleInstall">
		<defName>ABYautja_InstallWristbladeLauncher</defName>
		<label>install a wristblade launcher</label>
		<description>Install a wristblade launcher.</description>
		<jobString>installing wristblade launcher.</jobString>
		<incompatibleWithHediffTags>
			<li>GauntletModuleTag_Combat</li>
		</incompatibleWithHediffTags>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_WristbladeLauncher</ThingDef>
			<HediffDef>ABYautja_WristbladeLauncher</HediffDef>
		</descriptionHyperlinks>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ABYautja_WristbladeLauncher</li>
					</thingDefs>
				</filter>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ABYautja_WristbladeLauncher</li>
			</thingDefs>
		</fixedIngredientFilter>
		<addsHediff>ABYautja_WristbladeLauncher</addsHediff>
		<uiIconThing>ABYautja_WristbladeLauncher</uiIconThing>
	</RecipeDef>
	
	<RecipeDef ParentName="GauntletModuleRemove">
		<defName>ABYautja_WristbladeLauncherRemove</defName>
		<workerClass>ABXenotypeYautja.Recipe_RemoveGauntletModule</workerClass>
		<label>remove wristblade launcher</label>
		<description>remove wristblade launcher.</description>
		<jobString>remove wristblade launcher.</jobString>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_WristbladeLauncher</ThingDef>
			<HediffDef>ABYautja_WristbladeLauncher</HediffDef>
		</descriptionHyperlinks>
		<removesHediff>ABYautja_WristbladeLauncher</removesHediff>
	</RecipeDef>
	
