<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="ABYautja_ApparelMakeable_Base" Name="ABYautja_Apparel_ThermalMesh">
		<defName>ABYautja_Apparel_ThermalMesh</defName>
		<label>predator thermal mesh</label>
		<description>A heated mesh to help the yautja fight external elements. It mixes natural fibres with a self-regulating, plasteel mesh.</description>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_Mesh/Yautja_Mesh</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<techLevel>Medieval</techLevel>
		<costList>
			<Plasteel>5</Plasteel>
		</costList>
		<costStuffCount>50</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<tradeability>Sellable</tradeability>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>1800</WorkToMake>
			<Mass>0.4</Mass>
			<StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.55</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.55</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<apparel>
			<developmentalStageFilter>Child,Adult</developmentalStageFilter>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_Mesh/Yautja_Mesh</wornGraphicPath>
			<layers>
				<li>OverSkin</li>
			</layers>
			<tags>
				<li>YautjaApparel</li>
				<li>YautjaWebbing</li>
			</tags>
		</apparel>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_T2</researchPrerequisite>
			<recipeUsers>
				<li>ABYautja_TableMachining</li>
				<li>ElectricTailoringBench</li>
				<li>HandTailoringBench</li>
			</recipeUsers>
		</recipeMaker>
		<researchPrerequisites>
			<li>ComplexClothing</li>
		</researchPrerequisites>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_Apparel_ThermalMesh">
		<defName>ABYautja_KidApparel_ThermalMesh</defName>
		<label>predator pup thermal mesh</label>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_Mesh/Yautja_KidMesh</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.7</drawSize>
		</graphicData>
		<costStuffCount Inherit="False">25</costStuffCount>
		<statBases>
			<WorkToMake Inherit="False">400</WorkToMake>
		</statBases>
		<apparel>
			<developmentalStageFilter>Child</developmentalStageFilter>
			<tags>
				<li>YautjaKidApparel</li>
				<li>YautjaKidWebbing</li>
			</tags>
		</apparel>
	</ThingDef>

	<ThingDef ParentName="ABYautja_Apparel_ThermalMesh" Name="ABYautja_Apparel_AdvancedThermalMesh">
		<defName>ABYautja_Apparel_AdvancedThermalMesh</defName>
		<label>predator advanced thermal mesh</label>
		<techLevel>Spacer</techLevel>
		<costList>
			<Plasteel>10</Plasteel>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<costStuffCount>60</costStuffCount>
		<statBases>
			<StuffEffectMultiplierInsulation_Cold>1.35</StuffEffectMultiplierInsulation_Cold>
			<EquipDelay>2.5</EquipDelay>
		</statBases>
		<apparel>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<tags Inherit="False">
				<li>YautjaApparel</li>
				<li>YautjaMesh</li>
			</tags>
		</apparel>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_T4</researchPrerequisite>
			<recipeUsers Inherit="False">
				<li>ABYautja_TableMachining</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>4</Crafting>
			</skillRequirements>
		</recipeMaker>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_Apparel_AdvancedThermalMesh">
		<defName>ABYautja_KidApparel_AdvancedThermalMesh</defName>
		<label>predator pup advanced thermal mesh</label>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_Mesh/Yautja_KidMesh</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.7</drawSize>
		</graphicData>
		<costStuffCount Inherit="False">30</costStuffCount>
		<statBases>
			<WorkToMake Inherit="False">400</WorkToMake>
		</statBases>
		<apparel>
			<developmentalStageFilter>Child</developmentalStageFilter>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<tags>
				<li>YautjaKidApparel</li>
				<li>YautjaKidMesh</li>
			</tags>
		</apparel>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_ApparelMakeable_Base">
		<defName>ABYautja_Apparel_TribalCloak</defName>
		<label>tribal cloak</label>
		<description>A full-body garment crafted using neolithic tools. While it may look primitive, it is effective at insulating the wearer.</description>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_Cloak/YautjaCloak</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<techLevel>Neolithic</techLevel>
		<costStuffCount>70</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<tradeability>Sellable</tradeability>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>1800</WorkToMake>
			<Mass>0.4</Mass>
			<StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.65</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.45</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<apparel>
		<useWornGraphicMask>true</useWornGraphicMask>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_Cloak/YautjaCloak</wornGraphicPath>
			<layers>
				<li>Shell</li>
			</layers>
			<tags>
				<li>Neolithic</li>
			</tags>
		</apparel>
		<recipeMaker>
			<recipeUsers>
				<li>ElectricTailoringBench</li>
				<li>HandTailoringBench</li>
				<li>CraftingSpot</li>
			</recipeUsers>
		</recipeMaker>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(0.4,0.3,0.15)</only>
				</li>
				<li>
					<weight>15</weight>
					<only>(0.6,0.45,0.18)</only>
				</li>
				<li>
					<weight>20</weight>
					<only>(0.8,0.6,0.23)</only>
				</li>
			</options>
		</colorGenerator>
	</ThingDef>
</Defs>