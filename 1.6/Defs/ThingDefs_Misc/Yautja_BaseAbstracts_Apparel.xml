<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--Base-->
	<ThingDef Name="ABYautja_Apparel_NoQuality_Base" Abstract="True">
		<thingClass>Apparel</thingClass>
		<category>Item</category>
		<drawerType>MapMeshOnly</drawerType>
		<selectable>True</selectable>
		<pathCost>14</pathCost>
		<useHitPoints>True</useHitPoints>
		<techLevel>Neolithic</techLevel>
		<graphicData>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
		</graphicData>
		<drawGUIOverlay>true</drawGUIOverlay>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<DeteriorationRate>2</DeteriorationRate>
			<Beauty>-3</Beauty>
		</statBases>
		<recipeMaker>
			<recipeUsers>
				<li>ABYautja_TableMachining</li>
			</recipeUsers>
		</recipeMaker>
		<apparel>
			<canBeDesiredForIdeo>true</canBeDesiredForIdeo>
		</apparel>
		<altitudeLayer>Item</altitudeLayer>
		<alwaysHaulable>True</alwaysHaulable>
		<tickerType>Never</tickerType>
		<burnableByRecipe>true</burnableByRecipe>
		<smeltable>true</smeltable>
		<rotatable>false</rotatable>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
			<li>
				<compClass>CompColorable</compClass>
			</li>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_Apparel_NoQuality_Base" Name="ABYautja_Apparel_Base" Abstract="True">
	<comps>
		<li>
			<compClass>CompQuality</compClass>
		</li>
		<li Class="CompProperties_Styleable"/>
	</comps>
	</ThingDef>

<!--Apparel-->
	<ThingDef ParentName="ABYautja_Apparel_Base" Name="ABYautja_ApparelMakeable_Base" Abstract="True">
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Tailor</effectWorking>
			<soundWorking>Recipe_Tailor</soundWorking>
			<unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
			<recipeUsers>
				<li>ElectricTailoringBench</li>
				<li>HandTailoringBench</li>
				<li>ABYautja_TableMachining</li>
			</recipeUsers>
			<defaultIngredientFilter>
				<categories>
					<li>Root</li>
				</categories>
				<disallowedThingDefs>
					<li>Gold</li>
					<li>Silver</li>
					<li>Jade</li>
					<li>Uranium</li>
					<li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
					<li MayRequire="Ludeon.RimWorld.Odyssey">Obsidian</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>
		</recipeMaker>
		<thingCategories>
			<li>ABYautja_Apparel</li>
		</thingCategories>
		<tradeTags>
			<li>ABYautjaClothing</li>
		</tradeTags>
	</ThingDef>

<!--Armor-->
	<ThingDef ParentName="ABYautja_Apparel_Base" Name="ABYautja_ArmorMakeable_Base" Abstract="True">
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Machining</soundWorking>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
			<recipeUsers>
				<li>ABYautja_TableMachining</li>
			</recipeUsers>
			<defaultIngredientFilter>
			<categories>
				<li>Root</li>
			</categories>
				<disallowedThingDefs>
					<li>Gold</li>
					<li>Silver</li>
					<li>Jade</li>
					<li MayRequire="Ludeon.RimWorld.Anomaly">Bioferrite</li>
					<li MayRequire="Ludeon.RimWorld.Odyssey">Obsidian</li>
				</disallowedThingDefs>
			</defaultIngredientFilter>
		</recipeMaker>
		<costStuffCount>100</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<thingCategories Inherit="False">
			<li>ABYautja_Armor</li>
		</thingCategories>
		<tradeTags>
			<li>ABYautjaArmor</li>
		</tradeTags>
		<colorGenerator Class="ColorGenerator_StandardApparel" />
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_ArmorMakeable_Base" Name="ABYautja_ArmorBiocoded_Base" Abstract="True">
		<comps>
			<li Class="CompProperties_Biocodable"/>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_ArmorBiocoded_Base" Name="ABYautja_NobleArmorMakeable_Base" Abstract="True">
		<thingCategories Inherit="False">
			<li>ABYautja_NobleArmor</li>
		</thingCategories>
		<tradeTags Inherit="False">
				<li>ABYautjaNobleArmor</li>
		</tradeTags>
	</ThingDef>

	<ThingDef ParentName="ABYautja_ArmorBiocoded_Base" Name="ABYautja_Extremitywear_Base" Abstract="True">
		<thingCategories Inherit="False">
			<li>ABYautja_Apparel</li>
		</thingCategories>
		<apparel>
			<layers Inherit="False">
				<li>Middle</li>
			</layers>
		</apparel>
		<costStuffCount Inherit="False">50</costStuffCount>
	</ThingDef>
	
<!--Helmet-->
	<ThingDef ParentName="ABYautja_ArmorMakeable_Base" Name="ABYautja_HelmetMakeable_Base" Abstract="True">
		<thingCategories Inherit="False">
			<li>ABYautja_ArmorHeadgear</li>
		</thingCategories>
		<apparel>
			<parentTagDef>ApparelHead</parentTagDef>
		</apparel>
		<tradeTags Inherit="False">
				<li>ABYautjaHeadgear</li>
		</tradeTags>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_HelmetMakeable_Base" Name="ABYautja_HelmetBiocoded_Base" Abstract="True">
		<comps>
			<li Class="CompProperties_Biocodable"/>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_HelmetBiocoded_Base" Name="ABYautja_NobleHelmetMakeable_Base" Abstract="True">
		<thingCategories Inherit="False">
			<li>ABYautja_NobleArmorHeadgear</li>
		</thingCategories>
		<apparel>
			<parentTagDef>ApparelHead</parentTagDef>
		</apparel>
		<tradeTags>
				<li>ABYautjaNobleHeadgear</li>
		</tradeTags>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_HelmetBiocoded_Base" Name="ABYautja_BioMaskBase" Abstract="True">
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<renderSkipFlags>
				<li>None</li>
			</renderSkipFlags>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<layers>
				<li>Overhead</li>
			</layers>
			<drawData>
				<dataNorth>
					<layer>-3</layer>
				</dataNorth>
			</drawData>
		</apparel>
	</ThingDef>

<!--Utility/Equipment-->
	<ThingDef ParentName="ABYautja_Apparel_NoQuality_Base" Name="ABYautja_Utility_Base" Abstract="True">
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<scoreOffset>20</scoreOffset>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<careIfDamaged>false</careIfDamaged>
			<ignoredByNonViolent>true</ignoredByNonViolent>
			<wearPerDay>0</wearPerDay>
			<tags>
				<li>ABYautja_Equipment</li>
			</tags>
		</apparel>
		<resourceReadoutPriority>Middle</resourceReadoutPriority>
		<tradeNeverStack>true</tradeNeverStack>
		<smeltable>false</smeltable>
		<burnableByRecipe>false</burnableByRecipe>
		<drawGUIOverlay>false</drawGUIOverlay>
		<thingCategories Inherit="False">
			<li>ABYautja_Equipment</li>
		</thingCategories>
		<tradeTags>
				<li>ABYautjaEquipment</li>
		</tradeTags>
		<costStuffCount>100</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Machining</soundWorking>
			<skillRequirements>
				<Crafting>8</Crafting>
			</skillRequirements>
		</recipeMaker>
		<comps Inherit="False">
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Styleable"/>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_Utility_Base" Name="ABYautja_UtilityBiocoded_Base" Abstract="True">
		<comps>
			<li Class="CompProperties_Biocodable"/>
		</comps>
	</ThingDef>
	
	<ThingDef ParentName="ABYautja_UtilityBiocoded_Base" Name="ABYautja_ShoulderTurret_Base" Abstract="True">
		<tickerType>Normal</tickerType>
		<techLevel>Industrial</techLevel>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_Tracking</researchPrerequisite>
		</recipeMaker>
		<equippedStatOffsets>
			<MoveSpeed>-0.03</MoveSpeed>
			<WorkSpeedGlobal>-0.02</WorkSpeedGlobal>
		</equippedStatOffsets>
		<apparel>
			<wornGraphicPath>Things/Equipment/Shoulder_Guns/Yautja_ShoulderCannon</wornGraphicPath>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<careIfDamaged>false</careIfDamaged>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<bodyPartGroups>
				<li>Shoulders</li>
			</bodyPartGroups>
			<layers Inherit="False">
				<li>Belt</li>
			</layers>
			<tags>
				<li>ABYautja_Equipment</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<wornGraphicData>
				<renderUtilityAsPack>true</renderUtilityAsPack>
				<north>
					<offset>(0,-0.01)</offset>
					<hulk>
						<offset>(0.15,0.01)</offset>
					</hulk>
					<fat>
						<offset>(0.1,0.01)</offset>
					</fat>
					<female>
						<offset>(0.05,0)</offset>
					</female>
					<male>
						<offset>(0.038,0.01)</offset>
					</male>
					<thin>
						<offset>(0.05,0)</offset>
					</thin>
				</north>
				<south>
					<offset>(-0.05,0.15)</offset>
					<female>
						<offset>(-0.03,-0.15)</offset>
					</female>
					<hulk>
						<offset>(-0.08,-0.05)</offset>
					</hulk>
					<fat>
						<offset>(-0.065,-0.15)</offset>
					</fat>
					<thin>
						<offset>(-0.03,-0.2)</offset>
					</thin>
					<male>
						<offset>(-0.03,-0.1)</offset>
					</male>
				</south>
				<east>
					<offset>(-0.33,0.13)</offset>
					<female>
						<offset>(-0.05,-0.03)</offset>
					</female>
					<hulk>
						<offset>(-0.2,-0.0)</offset>
					</hulk>
					<fat>
						<offset>(-0.12,-0.0)</offset>
					</fat>
					<thin>
						<offset>(-0.03,-0.1)</offset>
					</thin>
					<male>
						<offset>(-0.09,-0.035)</offset>
					</male>
				</east>
				<male>
					<scale>(0.75,0.75)</scale>
				</male>
				<female>
					<scale>(0.75,0.75)</scale>
				</female>
				<thin>
					<scale>(0.7,0.7)</scale>
				</thin>
				<hulk>
					<scale>(0.9,0.9)</scale>
				</hulk>
				<fat>
					<scale>(0.9,0.9)</scale>
				</fat>
			</wornGraphicData>
		</apparel>
	</ThingDef>

<!--Shield-->
	<ThingDef Name="ABYautja_Shield_Base" ParentName="ABYautja_BaseMeleeWeapon_Blunt_Quality" Abstract="True">
        <techLevel>Medieval</techLevel>
        <thingCategories Inherit="False">
            <li>ABYautja_Equipment</li>
        </thingCategories>
		<thingClass>VEF.Apparels.Apparel_Shield</thingClass>
		<apparel>
			<bodyPartGroups>
				<li>LeftHand</li>
			</bodyPartGroups>
			<layers>
				<li>VFEC_OuterShell</li>
			</layers>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<canBeDesiredForIdeo>true</canBeDesiredForIdeo>
		</apparel>
        <comps>
            <li>
                <compClass>CompColorable</compClass>
            </li>
			<li Class="CompProperties_Biocodable"/>
        </comps>
        <equippedAngleOffset>-30</equippedAngleOffset>
    </ThingDef>
</Defs>