<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="ABBenchBase">
		<defName>ABYautja_TableMachining</defName>
		<label>predator machining table</label>
		<description>A yautja work station for assembling or breaking down machinery like components, armour, guns and ammunition, or dead mechanoids.</description>
		<graphicData>
			<texPath>Things/Buildings/Yautja/TableMachining</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<castEdgeShadows>false</castEdgeShadows>
		<staticSunShadowHeight>0.00</staticSunShadowHeight>
		<costList>
			<Steel>150</Steel>
			<Plasteel>10</Plasteel>
			<ComponentIndustrial>5</ComponentIndustrial>
		</costList>
		<useHitPoints>false</useHitPoints>
		<statBases>
			<WorkToBuild>3000</WorkToBuild>
			<MaxHitPoints>300</MaxHitPoints>
			<Flammability>0</Flammability>
			<Mass>40</Mass>
		</statBases>
		<size>(3,2)</size>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<constructionSkillPrerequisite>8</constructionSkillPrerequisite>
		<recipes>
			<li>ButcherCorpseMechanoid</li>
		</recipes>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>350</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="CompProperties_Glower">
				<glowRadius>5</glowRadius>
				<glowColor>(73,123,138,0)</glowColor>
			</li>
			<li Class="CompProperties_Breakdownable"/>
		</comps>
		<designationHotKey>Misc1</designationHotKey>
		<constructEffect>ConstructMetal</constructEffect>
		<researchPrerequisites>
			<li>ABYautja_Tech_T2</li>
		</researchPrerequisites>
	</ThingDef>
	
	<ThingDef ParentName="ABBenchBase">
		<defName>ABYautja_TinkeringTable</defName>
		<label>predator tinkering table</label>
		<description>A clean table with a wide collection of tools of all shapes. Yautja use this table to alter technology.</description>
		<graphicData>
			<texPath>Things/Buildings/Yautja/TableTinkering</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(3.5,1.5)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<staticSunShadowHeight>0.20</staticSunShadowHeight>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<useHitPoints>true</useHitPoints>
		<statBases>
			<WorkToBuild>2250</WorkToBuild>
			<MaxHitPoints>250</MaxHitPoints>
			<Flammability>1.0</Flammability>
			<Cleanliness>-4</Cleanliness>
			<Mass>25</Mass>
		</statBases>
		<size>(3,1)</size>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<designationHotKey>Misc1</designationHotKey>
		<researchPrerequisites>
			<li>ABYautja_Tech_T2</li>
		</researchPrerequisites>
		<building>
			<paintable>true</paintable>
		</building>
	</ThingDef>
	
