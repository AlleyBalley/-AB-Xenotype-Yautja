<Defs>

<!--Wood-->
	<HediffDef ParentName="ABGauntletProstheticHediffBase_Tribal">
		<defName>ABYautja_WoodLog_TribalGauntlet</defName>
		<label>wooden limb with wooden gauntlet</label>
		<description>A wooden gauntlet attached to a wooden limb. Allows for the attachment of wristblades.</description>
		<descriptionHyperlinks>
			<ThingDef>WoodLogWithGauntlet_TribalGauntlet</ThingDef>
		</descriptionHyperlinks>
		<addedPartProps>
			<solid>true</solid>
			<partEfficiency>0.3</partEfficiency>
		</addedPartProps>
		<spawnThingOnRemoved>WoodLogWithGauntlet_TribalGauntlet</spawnThingOnRemoved>
	</HediffDef>
	
