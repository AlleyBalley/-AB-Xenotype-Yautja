<!--Chestplates-->	
	<ThingDef ParentName="ABYautja_ArmorBiocoded_Base">
		<defName>ABYautja_Armor_ChestplateLight</defName>
		<label>predator light chestplate</label>
		<description>A light chestplate designed with freedom of movements in mind.</description>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_LightArmor/Yautja_LightArmor</texPath>
			<shaderType>CutoutComplex</shaderType>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<techLevel>Medieval</techLevel>
		<statBases>
			<MarketValue>1500</MarketValue>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToMake>30000</WorkToMake>
			<ArmorRating_Sharp>1.25</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.66</ArmorRating_Blunt>
			<ArmorRating_Heat>0.67</ArmorRating_Heat>
			<Insulation_Heat>6</Insulation_Heat>
			<Insulation_Cold>6</Insulation_Cold>
			<Mass>3</Mass>
		</statBases>
		<equippedStatOffsets>
			<MoveSpeed>+0.2</MoveSpeed>
		</equippedStatOffsets>
		<costList>
			<Steel>40</Steel>
			<Plasteel>30</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_T2</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Neck</li>
				<li>Shoulders</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_LightArmor/Yautja_LightArmor</wornGraphicPath>
			<layers>
				<li>Middle</li>
			</layers>
			<tags>
				<li>YautjaLightChestplate</li>
				<li>YautjaLightArmor</li>
			</tags>
		</apparel>
		<researchPrerequisites>
			<li>Smithing</li>
			<li>ComplexClothing</li>
		</researchPrerequisites>
	</ThingDef>

