	<ThingDef ParentName="ABYautja_Shield_Base">
        <defName>ABYautja_Shield_Predator</defName>
        <label>predator shield</label>
        <description>A collapsing shield that forms an oval.</description>
        <graphicData>
            <texPath>Things/Equipment/Shields/Predator_Shield/Predator_Shield</texPath>
            <graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.75</drawSize>
        </graphicData>
        <stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>250</costStuffCount>
        <statBases>
            <MaxHitPoints>500</MaxHitPoints>
            <Flammability>0.37</Flammability>
            <ArmorRating_Sharp>0.75</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.70</ArmorRating_Blunt>
            <ArmorRating_Heat>0.6</ArmorRating_Heat>
            <WorkToMake>4000</WorkToMake>
            <Mass>4</Mass>
        </statBases>
		<equippedStatOffsets>
            <ShootingAccuracyPawn>-0.8</ShootingAccuracyPawn>
            <MeleeHitChance>-0.5</MeleeHitChance>
            <MeleeDodgeChance>-0.5</MeleeDodgeChance>
        </equippedStatOffsets>
		<recipeMaker>
			<unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
			<researchPrerequisite>ABYautja_Tech_T2</researchPrerequisite>
            <recipeUsers>
                <li>ABYautja_TableMachining</li>
            </recipeUsers>
			<skillRequirements>
				<Crafting>3</Crafting>
			</skillRequirements>
		</recipeMaker>
        <comps>
            <li Class="VEF.Apparels.CompProperties_Shield">
                <shieldTags>
                    <li>YautjaFull</li>
                </shieldTags>
                <useDeflectMetalEffect>true</useDeflectMetalEffect>
				<coveredBodyPartGroups>
                    <li>Torso</li>
					<li>Arms</li>
                    <li>Hands</li>
                </coveredBodyPartGroups>
                <offHandGraphicData>
                    <texPath>Things/Equipment/Shields/Predator_Shield/Predator_Shield</texPath>
                    <graphicClass>Graphic_Multi</graphicClass>
                    <shaderType>CutoutComplex</shaderType>
                    <drawSize>1.2</drawSize>
                </offHandGraphicData>
                <offHandHoldOffset>
                    <northDefault>
                        <offset>(0, 0, 0.2)</offset>
                        <behind>true</behind>
                    </northDefault>
                    <east>
                        <offset>(-0.05, 0, 0.2)</offset>
                        <behind>true</behind>
                    </east>
                    <south>
                        <offset>(0, -0.04, 0.2)</offset>
                    </south>
                    <west>
                        <offset>(0.05, 0, 0.2)</offset>
                    </west>
                </offHandHoldOffset>
            </li>
        </comps>
		<colorGenerator Class="ColorGenerator_StandardApparel" />
		<tools>
            <li>
                <label>base</label>
                <capacities>
                    <li>Poke</li>
                </capacities>
                <power>12</power>
                <cooldownTime>2</cooldownTime>
            </li>
            <li>
                <label>centre</label>
                <labelUsedInLogging>false</labelUsedInLogging>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>13</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
    </ThingDef>
	
