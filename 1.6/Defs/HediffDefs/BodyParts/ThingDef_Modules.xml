	<ThingDef ParentName="ABYautja_BodyPartGauntlet_BladeModuleBase">
		<defName>ABYautja_ScimitarWristblade</defName>
		<label>scimitar wristblade</label>
		<description>An extremely long, sharp blade ready to be attached to a gauntlet. When sheathed it reaches the knee, but when extended it can easily reach the ground. While this blade offers brutal damage it's immense size does inhibit the wearer's maneuverability.</description>
		<descriptionHyperlinks>
			<HediffDef>ABYautja_ScimitarWristblade</HediffDef>
			<RecipeDef>ABYautja_InstallScimitarWristblade</RecipeDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Things/Item/Yautja/ScimitarWristblade</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.3</drawSize>
		</graphicData>
		<statBases>
			<WorkToMake>1750</WorkToMake>
			<MarketValue>24</MarketValue>
			<Mass>0.9</Mass>
			<Flammability>0</Flammability>
