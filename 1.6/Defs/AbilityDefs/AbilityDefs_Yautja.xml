<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--Abilities-->
	<AbilityDef>
		<defName>ABYautja_Ambush</defName>
		<label>Ambush</label>
		<description>Jump to a nearby location.</description>
		<iconPath>UI/Abilities/Longjump</iconPath>
		<cooldownTicksRange>100</cooldownTicksRange>
		<writeCombatLog>true</writeCombatLog>
		<hostile>false</hostile>
		<aiCanUse>true</aiCanUse>
		<jobDef>CastJump</jobDef>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbilityJump</verbClass>
			<label>jump</label>
			<violent>false</violent>
			<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
			<warmupTime>0.7</warmupTime>
			<range>7</range>
			<requireLineOfSight>true</requireLineOfSight>
			<soundCast>Longjump_Jump</soundCast>
			<soundLanding>Longjump_Land</soundLanding>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
				<canTargetPawns>false</canTargetPawns>
				<canTargetBuildings>false</canTargetBuildings>
			</targetParams>
		</verbProperties>
	</AbilityDef>
	
	<AbilityDef Name="CloakingBase">
		<defName>ABYautja_Cloaking</defName>
		<label>invisibility cloak</label>
		<description>Use the shifter's ability to temporarily hide your corporeal form.</description>
		<iconPath>UI/Abilities/Yautja_Invisibility</iconPath>
		<cooldownTicksRange>1250</cooldownTicksRange>
		<!-- 30 Minutes  -->
		<writeCombatLog>true</writeCombatLog>
		<hotKey>Misc12</hotKey>
		<targetRequired>false</targetRequired>
		<aiCanUse>true</aiCanUse>
		<jobDef>CastAbilityOnThing</jobDef>
		<canUseAoeToGetTargets>False</canUseAoeToGetTargets>
		<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<statBases>
			<Ability_Duration>20</Ability_Duration>
		</statBases>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<drawAimPie>false</drawAimPie>
			<requireLineOfSight>false</requireLineOfSight>
			<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
			<violent>false</violent>
			<warmupTime>1</warmupTime>
			<range>1</range>
			<targetable>false</targetable>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
				<canTargetPawns>false</canTargetPawns>
				<canTargetAnimals>false</canTargetAnimals>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="CompProperties_AbilityGiveHediff">
				<compClass>CompAbilityEffect_GiveHediff</compClass>
				<hediffDef>ABYautja_Invisibility</hediffDef>
			</li>
			<li Class="CompProperties_AbilityFleckOnTarget">
				<fleckDef>PsycastPsychicEffect</fleckDef>
			</li>
		</comps>
	</AbilityDef>
	
	<AbilityDef ParentName="CloakingBase">
	<defName>ABYautja_Cloaking_NPC</defName>
		<statBases Inherit="False">
			<Ability_Duration>10</Ability_Duration>
		</statBases>
		<charges>3</charges>
		<cooldownPerCharge>true</cooldownPerCharge>
	</AbilityDef>
</Defs>