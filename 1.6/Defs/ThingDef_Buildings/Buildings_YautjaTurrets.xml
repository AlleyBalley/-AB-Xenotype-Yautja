	<ThingDef ParentName="ABYautjaHeavyTurretBase">
		<defName>ABYautja_Turret_HeavyPredGun</defName>
		<label>heavy pred-gun</label>
		<description>A heavy automatic turret. It's large plasma charges do heavy damage over significant ranges, but it's barrel must be refurbished after use. It cannot fire at close-up targets, and may explode when damaged.</description>    
		<uiIconPath>Things/Buildings/Security/Yautja_HeavyPredGun_MenuIcon</uiIconPath>
		<statBases>
			<ShootingAccuracyTurret>0.98</ShootingAccuracyTurret>
		</statBases>
		<costList>
			<Steel>330</Steel>
			<Uranium>15</Uranium>
			<Plasteel>60</Plasteel>
			<ComponentIndustrial>3</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<statBases>
			<MaxHitPoints>600</MaxHitPoints>
			<Flammability>0.7</Flammability>
			<WorkToBuild>25000</WorkToBuild>
			<Mass>100</Mass>
			<Beauty>-20</Beauty>
		</statBases>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_Refuelable">
