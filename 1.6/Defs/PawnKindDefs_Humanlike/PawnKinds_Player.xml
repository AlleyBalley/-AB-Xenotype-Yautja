<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<PawnKindDef ParentName="BaseYautjaPawnKind">
		<defName>Colonist_ABYautja</defName>
		<label>Yautja colonist</label>
		<defaultFactionType>ABYautja_PlayerColony</defaultFactionType>
		<apparelTags>
			<li>YautjaGreaves</li>
			<li>YautjaWebbing</li>
			<li>Neolithic</li>
		</apparelTags>
		<apparelMoney>
			<min>5000</min>
			<max>10000</max>
		</apparelMoney>
		<techHediffsChance>0.03</techHediffsChance>
		<techHediffsMoney>50~800</techHediffsMoney>
		<techHediffsTags>
			<li>Poor</li>
			<li>Simple</li>
			<li>ImplantEmpireCommon</li>
			<li>YautjaTribalEquipment</li>
		</techHediffsTags>
		<backstoryCryptosleepCommonality>1</backstoryCryptosleepCommonality>
	</PawnKindDef>
  
