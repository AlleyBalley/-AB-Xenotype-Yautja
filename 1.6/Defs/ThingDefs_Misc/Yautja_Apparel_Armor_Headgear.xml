<Defs>
		
<!--Masks-->
	<ThingDef ParentName="ABYautja_BioMaskBase">
		<defName>ABYautja_Armor_BioMaskLight</defName>
		<label>predator light bio-mask</label>
		<description>A lighter variant of the standard yautja bio-mask. The helmet offers less protection than the standard variant while still incorporating a respirator to avoid inhaling toxic compounds. The helmet is also equipped with more advanced targeting system and vision enhancing utilities.</description>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_LightBiomask/Yautja_LightBiomask</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<techLevel>Medieval</techLevel>
		<statBases>
			<Mass>0.25</Mass>
			<MarketValue>750</MarketValue>
			<MaxHitPoints>350</MaxHitPoints>
			<WorkToMake>25000</WorkToMake>
			<ArmorRating_Sharp>0.8</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.30</ArmorRating_Blunt>
			<ArmorRating_Heat>0.5</ArmorRating_Heat>
			<Insulation_Heat>3</Insulation_Heat>
			<Insulation_Cold>10</Insulation_Cold>
		</statBases>
		<equippedStatOffsets>
			<ShootingAccuracyPawn>0.35</ShootingAccuracyPawn>
			<PsychicSensitivity>-0.10</PsychicSensitivity>
			<ToxicEnvironmentResistance>0.4</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.55</VacuumResistance>
		</equippedStatOffsets>
		<costList>
			<Plasteel>30</Plasteel>
			<Uranium>15</Uranium>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_T2</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<apparel>
			<wornGraphicPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_LightBiomask/Yautja_LightBiomask</wornGraphicPath>
			<tags>
				<li>YautjaLightHelmet</li>
				<li>YautjaLightArmor</li>
				<li>YautjaHelmet</li>
			</tags>
		</apparel>
		<researchPrerequisites>
			<li>Smithing</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="VEF.Apparels.ApparelExtension">
				<equippedStatFactors>
					<ShootingAccuracyFactor_Long>1.1</ShootingAccuracyFactor_Long>
					<ShootingAccuracyFactor_Medium>1.2</ShootingAccuracyFactor_Medium>
					<ShootingAccuracyFactor_Short>1.3</ShootingAccuracyFactor_Short>
				</equippedStatFactors>
			</li>
		</modExtensions>
	</ThingDef>

	<ThingDef ParentName="ABYautja_BioMaskBase">
