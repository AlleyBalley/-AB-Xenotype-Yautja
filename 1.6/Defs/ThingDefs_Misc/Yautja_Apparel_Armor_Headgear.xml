		<equippedStatOffsets>
			<ShootingAccuracyPawn>0.15</ShootingAccuracyPawn>
			<PsychicSensitivity>-0.10</PsychicSensitivity>
			<ToxicEnvironmentResistance>0.55</ToxicEnvironmentResistance>
			<VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.7</VacuumResistance>
		</equippedStatOffsets>
		<costList>
			<Plasteel>30</Plasteel>
