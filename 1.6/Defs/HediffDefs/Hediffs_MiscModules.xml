<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<HediffDef ParentName="GauntletModuleHediffBase_LastResort">
		<defName>ABYautja_SelfDestructDevice</defName>
		<label>self destruct device</label>
		<description>A explosive device meant to explode on the user's position as a last resort.</description>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_SelfDestructDevice</ThingDef>
			<RecipeDef>ABYautja_InstallSelfDestructDevice</RecipeDef>
		</descriptionHyperlinks>
		<comps>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
			<li Class="VEF.AnimalBehaviours.HediffCompProperties_Exploder">
				<explosionForce>3</explosionForce>
				<damageDef>BombSuper</damageDef>
			</li>
		</comps>
		<spawnThingOnRemoved>ABYautja_SelfDestructDevice</spawnThingOnRemoved>
	</HediffDef>
	
	<HediffDef ParentName="GauntletModuleHediffBase_Utility">
		<defName>ABYautja_CloakingDevice</defName>
		<label>shifter</label>
		<description>A small orb, about the size of a marbel, with the power to enshroud the user in invisibility. Many yautja call this a cloak, and have rituals to earn using it.</description>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_CloakingDevice</ThingDef>
			<RecipeDef>ABYautja_InstallCloakingDevice</RecipeDef>
		</descriptionHyperlinks>
		<abilities>
			<li>ABYautja_Cloaking</li>
		</abilities>
		<spawnThingOnRemoved>ABYautja_CloakingDevice</spawnThingOnRemoved>
	</HediffDef>
	
	<HediffDef>
		<hediffClass>HediffWithComps</hediffClass>
		<defName>ABYautja_Invisibility</defName>
		<label>cloaking field</label>
		<description>A temporary visual affect that makes the user appear invisible to others.</description>
		<isBad>false</isBad>
		<comps>
			<li Class="HediffCompProperties_Invisibility">
				<visibleToPlayer>true</visibleToPlayer>
			</li>
			<li Class="HediffCompProperties_Disappears">
				<showRemainingTime>True</showRemainingTime>
			</li>
			<li Class="HediffCompProperties_DisappearsOnDeath"/>
		</comps>
		<stages>
			<li>
				<minSeverity>0</minSeverity>
				<becomeVisible>true</becomeVisible>
				<statFactors>
					<MeleeDodgeChance>1.5</MeleeDodgeChance>
					<HuntingStealth>1.5</HuntingStealth>
				</statFactors>
			</li>
		</stages>
	</HediffDef>
</Defs>
