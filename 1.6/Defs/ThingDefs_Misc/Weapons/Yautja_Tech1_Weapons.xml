		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<recipeMaker>
			<recipeUsers>
				<li>ElectricSmithy</li>
				<li>FueledSmithy</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<researchPrerequisites>
			<li>RecurveBow</li>
		</researchPrerequisites>
		<modExtensions Inherit="False" />
	</ThingDef>
	
<!--Melee-->
	<ThingDef ParentName="ABYautja_BaseMeleeWeapon_Blunt">
		<defName>ABYautja_Melee_WarClub</defName>
		<label>war club</label>
		<description>A large slab of material shaped into a club. Features a retractable blade at the hilt and the head of the club.</description>
		<graphicData>
			<texPath>Things/Equipment/Melee/Yautja_WarClub</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>1.1</drawSize>
		</graphicData>
		<equippedAngleOffset>-17</equippedAngleOffset>
		<tickerType>Normal</tickerType>
		<stuffCategories>
			<li>Metallic</li>
			<li>Stony</li>
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>70</costStuffCount>
		<statBases>
			<MarketValue>100</MarketValue>
			<WorkToMake>500</WorkToMake>
			<Mass>2</Mass>
		</statBases>
		<weaponTags>
			<li>YautjaClub</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_T1</researchPrerequisite>
			<skillRequirements>
				<Crafting>2</Crafting>
			</skillRequirements>
			<recipeUsers>
				<li>ElectricSmithy</li>
				<li>FueledSmithy</li>
				<li>CraftingSpot</li>
			</recipeUsers>
		</recipeMaker>
		<tools>
			<li>
				<label>handle</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>10</power>
				<cooldownTime>1.7</cooldownTime>
			</li>
			<li>
				<label>club</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>16</power>
				<cooldownTime>1.4</cooldownTime>
			</li>
			<li>
				<label>club blade</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>13</power>
				<cooldownTime>2.4</cooldownTime>
			</li>
		</tools>
		<modExtensions>
			<li Class="VEF.Things.ThingDefExtension">
				<usableWithShields>true</usableWithShields>
				<weaponCarryDrawOffsets>
					<north>
						<drawOffset>(0.03, 0, -0.095)</drawOffset>
					</north>
					<east>
						<drawOffset>(0.02, 0, -0.095)</drawOffset>
					</east>
					<south>
						<drawOffset>(0.03, 0, -0.095)</drawOffset>
					</south>
					<west>
						<drawOffset>(-0.02, 0, -0.095)</drawOffset>
					</west>
				</weaponCarryDrawOffsets>
			</li>
		</modExtensions>
	</ThingDef>
	
	<ThingDef ParentName="ABBaseMeleeWeapon_Sharp_Quality">
		<defName>ABYautja_Melee_PredatorAxe</defName>
