<?xml version="1.0" encoding="utf-8" ?>
<Defs>
 
	<ThingDef ParentName="ABYautja_HelmetMakeable_Base">
		<defName>ABYautja_Apparel_TribalMask</defName>
		<label>predator tribal mask</label>
		<description>A light Tribal mask, the ancestor of the standard yautja bio-mask. The helmet offers far less protection than a bio-mask.</description>
		<graphicData>
		<texPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_LightBiomask/Yautja_LightBiomask_B</texPath>
		<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.15</Mass>
			<MarketValue>300</MarketValue>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>5000</WorkToMake>
			<ArmorRating_Sharp>0.45</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.20</ArmorRating_Blunt>
			<ArmorRating_Heat>0.15</ArmorRating_Heat>
			<Insulation_Heat>1</Insulation_Heat>
			<Insulation_Cold>1</Insulation_Cold>
		</statBases>
		<equippedStatOffsets>
			<PsychicSensitivity>-0.10</PsychicSensitivity>
		</equippedStatOffsets>
		<costStuffCount inherit="false">30</costStuffCount>
		<stuffCategories inherit="false">
			<li>Woody</li>
			<li>Stony</li>
			<li>Metallic</li>
		</stuffCategories>
		<recipeMaker>
			<recipeUsers>
				<li>CraftingSpot</li>
			</recipeUsers>
			<unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
			<researchPrerequisite>ABYautja_Tech_T1</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<renderSkipFlags>
				<li>None</li>
			</renderSkipFlags>
			<bodyPartGroups>
				<li>FullHead</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Pawn/Humanlike/Yautja/Apparel/Yautja_LightBiomask/Yautja_LightBiomask_B</wornGraphicPath>		
			<layers>
				<li>Overhead</li>
			</layers>
			<tags>
				<li>YautjaTribalHelmet</li>
			</tags>
			<drawData>
				<dataNorth>
					<layer>-3</layer>
				</dataNorth>
			</drawData>
		</apparel>
		<thingCategories Inherit="False">
			<li>ABYautja_Headgear</li>
		</thingCategories>
	</ThingDef>

</Defs>