	<ThingDef ParentName="ABYautja_BaseMakeableGun_PlasmaEnergy">
		<defName>ABYautja_Gun_PlasmaSpinningBlade</defName>
		<label>spinning plasma blade</label>
		<description>A thrown device that is comprised of two retractable blades. The sharp edges of these blades aren't metal, but instead made of red plasma.</description>
		<techLevel Inherit="False">Medieval</techLevel>
		<graphicData>
			<texPath>Things/Equipment/Ranged/Yautja_SpinningPlasmaBlade</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>0.8</drawSize>
		</graphicData>
		<soundInteract>Interact_BeatFire</soundInteract>
		<costList>
			<Steel>10</Steel>
			<ComponentYautja>1</ComponentYautja>
		</costList>
		<costStuffCount>25</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<statBases>
			<MarketValue>800</MarketValue>
			<WorkToMake>3100</WorkToMake>
			<Mass>0.7</Mass>
			<AccuracyTouch>1</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.30</AccuracyLong>
			<RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>90</equippedAngleOffset>
		<weaponTags>
				<li>YautjaSpinningPlasmaBlade</li>
		</weaponTags>
		<recipeMaker>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<verbs>
			<li>
				<verbClass>Verb_LaunchProjectile</verbClass>
				<label>Spinning plasma Blade</label>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>ABPlasmaSpinningBlade_Thrown</defaultProjectile>
				<warmupTime>1.45</warmupTime>
				<range>32</range>
				<soundCast>Interact_BeatFire</soundCast>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<tickerType>Normal</tickerType>
		<generateCommonality>0.15</generateCommonality>
		<modExtensions>
			<li Class="VEF.Things.ThingDefExtension">
				<weaponCarryDrawOffsets>
					<north>
						<drawOffset>(0, 0, -0.05)</drawOffset>
					</north>
					<east>
						<drawOffset>(0, 0, -0.05)</drawOffset>
					</east>
					<south>
						<drawOffset>(0, 0, -0.05)</drawOffset>
					</south>
					<west>
						<drawOffset>(0, 0, -0.05)</drawOffset>
					</west>
				</weaponCarryDrawOffsets>
			</li>
		</modExtensions>
	</ThingDef>
