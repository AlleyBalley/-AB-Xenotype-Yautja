	<RecipeDef ParentName="CombineWristbladeRecipe_Base">
		<defName>Make_ABYautja_ClawWristblades</defName>
		<label>craft a claw wristblade</label>
		<description>combine four prehensile wristblades and one wristblade into a claw.</description>
		<jobString>combine wristblades.</jobString>
		<workAmount>50</workAmount>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ABYautja_Wristblade</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ABYautja_PrehensileWristblade</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
