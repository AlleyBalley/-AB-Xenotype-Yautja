	<HediffDef ParentName="ABYautja_NPCUnbloodedWristbladeGauntlet">
		<defName>ABYautja_NPCLeaderWristbladeGauntlet</defName>
		<label>wristblade gauntlet</label>
		<description>A metal gauntlet attached to the wrist. This one comes pre-installed with dual metal blades, a shifter, a wrist rocket module, and a self destruct device.</description>
		<comps Inherit="False">
			<li Class="MVCF.Comps.HediffCompProperties_ExtendedVerbGiver">
				<verbs>
					<li>
						<verbClass>Verb_Shoot</verbClass>
						<label>wrist rocket</label>
						<hasStandardCommand>true</hasStandardCommand>
						<defaultProjectile>Gauntlet_WristRocket</defaultProjectile>
						<warmupTime>0.4</warmupTime>
						<range>30</range>
						<soundCast>Shot_NeedleGun</soundCast>
						<onlyManualCast>true</onlyManualCast>
						<targetParams>
							<canTargetLocations>false</canTargetLocations>
						</targetParams>
						<muzzleFlashScale>0</muzzleFlashScale>
					</li>
				</verbs>
				<verbProps>
					<li>
						<label>wrist rocket</label>
						<canBeToggled>false</canBeToggled>
						 <comps>
							<li Class="MVCF.VerbComps.VerbCompProperties_Cooldown">
								<compClass>MVCF.VerbComps.VerbComp_Cooldown</compClass>
								<cooldownTime>5</cooldownTime>
							</li>
							<li Class="MVCF.Reloading.Comps.VerbCompProperties_Reloadable">
								<compClass>MVCF.Reloading.Comps.VerbComp_Reloadable</compClass>
								<AmmoFilter>
									<thingDefs>
										<li>Shell_HighExplosive</li>
									</thingDefs>
								</AmmoFilter>
								<ItemsPerShot>1</ItemsPerShot>
								<MaxShots>5</MaxShots>
								<ReloadTimePerShot>2.5</ReloadTimePerShot>
							</li>
						</comps>
					</li>
				</verbProps>
			</li>
			<li Class="HediffCompProperties_VerbGiver">
				<tools>
					<li>
						<label>wristblade</label>
						<capacities>
							<li>Cut</li>
							<li>Stab</li>
						</capacities>
						<power>20</power>
						<cooldownTime>1.8</cooldownTime>
						<chanceFactor>0.75</chanceFactor>
						<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
						<soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
						<soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
					</li>
					<li>
						<label>wristblade point</label>
						<capacities>
							<li>Stab</li>
						</capacities>
						<power>16</power>
						<cooldownTime>1.6</cooldownTime>
						<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
						<soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
						<soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
					</li>
					<li>
						<label>wristblade edge</label>
						<capacities>
							<li>Cut</li>
						</capacities>
						<power>16</power>
						<cooldownTime>1.5</cooldownTime>
						<alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
						<soundMeleeHit>MeleeHit_BionicSlash</soundMeleeHit>
						<soundMeleeMiss>MeleeMiss_BionicSlash</soundMeleeMiss>
					</li>
				</tools>
			</li>
			<li Class="HediffCompProperties_DisappearsOnDeath" />
			<li Class="VEF.AnimalBehaviours.HediffCompProperties_Exploder">
				<explosionForce>3</explosionForce>
