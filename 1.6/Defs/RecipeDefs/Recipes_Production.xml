<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<RecipeDef>
		<defName>ABYautja_CraftComponentYautja</defName>
		<label>craft yautja component</label>
		<description>craft a yautja component.</description>
		<jobString>Craft yautja component.</jobString>
		<workAmount>4500</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<effectWorking>Cook</effectWorking>
		<soundWorking>Recipe_Machining</soundWorking>
		<unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Steel</li>
					</thingDefs>
				</filter>
				<count>5</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Gold</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentSpacer</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Steel</li>
				<li>Plasteel</li>
				<li>Gold</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<ComponentYautja>1</ComponentYautja>
		</products>
		<skillRequirements>
			<Crafting>8</Crafting>
		</skillRequirements>
		<researchPrerequisite>ABYautja_Tech_T3</researchPrerequisite>
		<workSkill>Crafting</workSkill>
		<recipeUsers>
			<li>ABYautja_TableMachining</li>
		</recipeUsers>
	</RecipeDef>
	
	<RecipeDef Name="ABYautja_ShapeWristblade">
		<defName>ABYautja_ShapeWristblade</defName>
		<label>shape wristblade from slag</label>
		<description>shape a wristblade for a gauntlet.</description>
		<jobString>shaping wristblade.</jobString>
		<workAmount>850</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<effectWorking>CutStone</effectWorking>
		<soundWorking>Recipe_MakeStoneBlocks</soundWorking>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ChunkSlagSteel</li>
						<li>ChunkMechanoidSlag</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ChunkSlagSteel</li>
				<li>ChunkMechanoidSlag</li>
			</thingDefs>
		</fixedIngredientFilter>
		<products>
			<ABYautja_Wristblade>2</ABYautja_Wristblade>
		</products>
		<skillRequirements>
			<Crafting>3</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
		<recipeUsers>
			<li>CraftingSpot</li>
			<li MayRequire="oskarpotocki.vfe.classical">VFEC_CraftingBench</li>
		</recipeUsers>
	</RecipeDef>
	
	<RecipeDef ParentName="ABYautja_ShapeWristblade">
		<defName>ABYautja_ShapeLongWristblade</defName>
		<label>shape long wristblade from slag</label>
		<description>shape a long wristblade for a gauntlet.</description>
		<jobString>shaping long wristblade.</jobString>
		<workAmount>1200</workAmount>
		<products Inherit="False">
			<ABYautja_LongWristblade>1</ABYautja_LongWristblade>
		</products>
	</RecipeDef>
</Defs>
