<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!--Ranged-->
	<ThingDef ParentName="ABYautja_SimpleRanged">
		<defName>ABYautja_Gun_Hunting_Bow</defName>
		<label>predator hunting bow</label>
		<description>This bow is a traditional weapon used by yautja of ancient times to hunt.</description>
		<graphicData>
			<texPath>Things/Equipment/Ranged/Yautja_Hunting_Bow</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>1</drawSize>			
		</graphicData>
		<soundInteract>Bow_Large</soundInteract>
		<statBases>
			<MarketValue>100</MarketValue>
			<WorkToMake>1000</WorkToMake>
			<Mass>1.0</Mass>
			<AccuracyTouch>0.65</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.75</AccuracyMedium>
			<AccuracyLong>0.50</AccuracyLong>
			<RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
			<li>YautjaBow</li>
			<li>YautjaHuntingBow</li>
			<li>YautjaRanged</li>
		</weaponTags>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Arrow_Yautja_Hunting_Bow</defaultProjectile>
				<warmupTime>1.25</warmupTime>
				<range>33</range>
				<soundCast>Bow_Large</soundCast>
			</li>
		</verbs>
		<tools>
			<li>
				<label>limb</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>9</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<costStuffCount>60</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<recipeMaker>
			<recipeUsers>
				<li>ElectricSmithy</li>
				<li>FueledSmithy</li>
				<li>CraftingSpot</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>3</Crafting>
			</skillRequirements>
		</recipeMaker>
		<modExtensions Inherit="False" />
	</ThingDef>
	
