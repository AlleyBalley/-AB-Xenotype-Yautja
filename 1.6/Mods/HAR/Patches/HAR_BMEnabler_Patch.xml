<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Bionic Modularity</li>
				</mods>
				<match Class="PatchOperationAddModExtension">
					<xpath>Defs/HediffDef[defName="ABYautja_SimpleProstheticMandible" or defName="ABYautja_BionicMandible" or defName="ABYautja_ArchotechMandible" or @Name="CombineProstheticandGauntlet_Base"]</xpath>
					<value>
						<li Class="BionicModularity.DefExtension_ModularHediff"></li>
					</value>
				</match>
			</li>

		<!--Bionic modularity modules-->
			<!--Base-->
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Bionic Modularity</li>
				</mods>
				<match Class="PatchOperationAdd">
					<xpath>Defs/RecipeDef[defName="BM_SpacerPowerFangCombatModule_InstallHuman" or defName="BM_SpacerPowerFangCombatModule_InstallHuman_Implant"]/appliedOnFixedBodyParts</xpath>
					<value>
						<li>ABYautja_UpperMandibles</li>
						<li>ABYautja_LowerMandibles</li>
						<li>ABYautja_Mouth</li>
					</value>
				</match>
			</li>
			
			<li Class="PatchOperationFindMod">
				<mods>
					<li>Bionic Modularity</li>
