			<li Class="PatchOperationRemove" MayRequire="erdelf.humanoidalienraces">
				<xpath>Defs/AlienRace.ThingDef_AlienRace[@Name="ABYautja_Race"]/alienRace/raceRestriction/conceptList</xpath>
			</li>
		</operations>
	</Operation>

