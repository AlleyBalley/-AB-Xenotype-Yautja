			</li>
		</operations>
	</Operation>
	
	<Operation Class="VEF.PatchOperationToggableSequence">
		<enabled>False</enabled>
		<label>Allow Friendly Yautja Factions violent memes that *aren't required* (Use with setting above!)</label>
		<operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/FactionDef[@Name="ABYautjaFactionBase"]/allowedMemes</xpath>
