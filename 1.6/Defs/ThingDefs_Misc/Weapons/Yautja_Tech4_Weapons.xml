<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<!--Ranged-->
	<ThingDef ParentName="ABYautja_BaseMakeableGun_T4">
		<defName>ABYautja_Gun_Burner</defName>
		<label>burner</label>
		<description>The burner is an assault-like weapon. It fires hot plasma in fast streams. Unblooded yautja are often given this weapon by older members to use on hunts.</description>
		<graphicData>
			<texPath>Things/Equipment/Ranged/Yautja_Burner</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>			
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_T4</researchPrerequisite>
			<skillRequirements>
				<Crafting>7</Crafting>
			</skillRequirements>
		</recipeMaker>
		<statBases>
			<MarketValue>1250</MarketValue>
			<WorkToMake>50000</WorkToMake>
			<Mass>3.5</Mass>
			<AccuracyTouch>0.60</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.55</AccuracyLong>
			<RangedWeapon_Cooldown>1.75</RangedWeapon_Cooldown>
		</statBases>
		<costStuffCount>50</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costList>
			<Plasteel>10</Plasteel>
			<ComponentIndustrial>3</ComponentIndustrial>
		</costList>
		<verbs>
			<li>
			<verbClass>Verb_Shoot</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>ABBullet_Plasma</defaultProjectile>
			<warmupTime>1.25</warmupTime>
			<range>25</range>
			<burstShotCount>4</burstShotCount>
			<ticksBetweenBurstShots>9</ticksBetweenBurstShots>
			<soundCast>ABShot_ShoulderCannon</soundCast>
			<soundCastTail>GunTail_Light</soundCastTail>
			<muzzleFlashScale>0</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>8</power>
				<cooldownTime>2</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>8</power>
				<cooldownTime>2</cooldownTime>
			</li>
		</tools>
		<weaponTags Inherit="False">
			<li>YautjaGun</li>
			<li>YautjaBlaster</li>
			<li>YautjaRanged</li>
		</weaponTags>
		<generateCommonality>0.05</generateCommonality>
	</ThingDef> 
<!--Melee-->
<!--Ranged+Melee-->
	<ThingDef ParentName="ABYautja_BaseMakeableGun_T4">
		<defName>ABYautja_Gun_PoliNanoDisc</defName>
		<label>poli nanovibronic disc</label>
		<description>The poli nanovibronic disc, often just shortened to disc, is very similar in function to the smart disc. The poli nanovibronic disc however provides a slightly more comfortable grib making it slightly less unweildy while also using more advanced target-homing technology that increases the chances of landing a hit when thrown significantly.</description>
		<techLevel Inherit="False">Industrial</techLevel>
		<graphicData>
			<texPath>Things/Equipment/Ranged/Yautja_PoliNanoDisc</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.9</drawSize>
		</graphicData>
		<weaponClasses>
			<li>Melee</li>
		</weaponClasses>
		<soundInteract>Interact_BeatFire</soundInteract>
		<costStuffCount>35</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costList>
			<Uranium>10</Uranium>
			<Plasteel>30</Plasteel>
			<ComponentIndustrial>1</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<statBases>
			<MarketValue>1250</MarketValue>
			<WorkToMake>6500</WorkToMake>
			<Mass>1</Mass>
			<AccuracyTouch>1.2</AccuracyTouch>
			<AccuracyShort>1</AccuracyShort>
			<AccuracyMedium>0.9</AccuracyMedium>
			<AccuracyLong>0.8</AccuracyLong>
			<RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
		</statBases>
		<weaponTags>
				<li>YautjaPoliNanoDisc</li>
		</weaponTags>
		<recipeMaker>
			<researchPrerequisite>ABYautja_Tech_T4</researchPrerequisite>
			<skillRequirements>
				<Crafting>6</Crafting>
			</skillRequirements>
		</recipeMaker>
		<verbs>
			<li>
				<verbClass>Verb_LaunchProjectile</verbClass>
				<label>PoliNanoDisc</label>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>ABPoliNanoDisc_Thrown</defaultProjectile>
				<warmupTime>1.1</warmupTime>
				<range>35</range>
				<soundCast>Interact_BeatFire</soundCast>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<tools>
			<li>
				<label>blade</label>
				<capacities>
					<li>Cut</li>
				</capacities>
				<power>22</power>
				 <cooldownTime>1.55</cooldownTime>
			</li>
			<li>
				<label>point</label>
				<capacities>
					<li>Stab</li>
				</capacities>
				<power>20</power>
				 <cooldownTime>1.55</cooldownTime>
			</li>
		</tools>
		<generateCommonality>0.05</generateCommonality>
		<comps>
			<li Class="MVCF.Comps.CompProperties_VerbProps">
				<compClass>MVCF.Comps.Comp_VerbProps</compClass>
				<verbProps>
					<li>
						<label>PoliNanoDisc</label>
						<canBeToggled>true</canBeToggled>
						<separateToggle>true</separateToggle>
						<toggleLabel>Toggle throwing</toggleLabel>
						<toggleDescription>Toggle the throwing of the poli nanovibronic disc</toggleDescription>
						<toggleIconPath>Things/Projectile/Yautja_PoliNanoDisc_Thrown</toggleIconPath>
						<comps>
							<li Class="MVCF.VerbComps.VerbCompProperties_Switch">
								<switchIcon>Things/Projectile/Yautja_PoliNanoDisc_Thrown</switchIcon>
								<startEnabled>true</startEnabled>
							</li>
						</comps>
					</li>
				</verbProps>
			</li>
		</comps>
		<modExtensions>
			<li Class="VEF.Things.ThingDefExtension">
				<weaponCarryDrawOffsets>
					<north>
						<drawOffset>(0, 0, -0.2)</drawOffset>
					</north>
					<east>
						<drawOffset>(0, 0, -0.2)</drawOffset>
					</east>
					<south>
						<drawOffset>(0, 0, -0.2)</drawOffset>
					</south>
					<west>
						<drawOffset>(0, 0, -0.2)</drawOffset>
					</west>
				</weaponCarryDrawOffsets>
			</li>
		</modExtensions>
	</ThingDef>
</Defs>