<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--Self destruct device-->
	<RecipeDef ParentName="GauntletModuleInstall">
		<defName>ABYautja_InstallSelfDestructDevice</defName>
		<label>install a self destruct device</label>
		<description>Install a self destruct device.</description>
		<jobString>installing self destruct device.</jobString>
		<incompatibleWithHediffTags>
			<li>GauntletModuleTag_LastResort</li>
		</incompatibleWithHediffTags>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_SelfDestructDevice</ThingDef>
			<HediffDef>ABYautja_SelfDestructDevice</HediffDef>
		</descriptionHyperlinks>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ABYautja_SelfDestructDevice</li>
					</thingDefs>
				</filter>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ABYautja_SelfDestructDevice</li>
			</thingDefs>
		</fixedIngredientFilter>
		<addsHediff>ABYautja_SelfDestructDevice</addsHediff>
		<uiIconThing>ABYautja_SelfDestructDevice</uiIconThing>
	</RecipeDef>
	
	<RecipeDef ParentName="GauntletModuleRemove">
		<defName>ABYautja_SelfDestructDeviceRemove</defName>
		<workerClass>ABXenotypeYautja.Recipe_RemoveGauntletModule</workerClass>
		<label>remove self destruct device</label>
		<description>remove self destruct device.</description>
		<jobString>remove self destruct device.</jobString>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_SelfDestructDevice</ThingDef>
			<HediffDef>ABYautja_SelfDestructDevice</HediffDef>
		</descriptionHyperlinks>
		<removesHediff>ABYautja_SelfDestructDevice</removesHediff>
	</RecipeDef>

