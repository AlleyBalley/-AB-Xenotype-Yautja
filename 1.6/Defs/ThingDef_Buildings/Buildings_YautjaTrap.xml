	<ThingDef ParentName="ABYautjaTrapBase">
		<defName>ABYautja_Trap_CutClamp</defName>
		<label>cut clamp trap</label>
		<description>A long, hinged, line of blades ready to snap closed at a moments notice.</description>
		<techLevel>Medieval</techLevel>
		<graphicData>
			<texPath>Things/Buildings/Security/Yautja_CutClamp_Trap_Armed</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.2,1.2)</drawSize>
			<drawOffset>(0,0,0.1)</drawOffset>
			<damageData>
				<rect>(0,0,1,0.15)</rect>
			</damageData>
		</graphicData>
		<statBases>
			<Mass>0.7</Mass>
			<MaxHitPoints>40</MaxHitPoints>
			<WorkToBuild>1400</WorkToBuild>
			<Flammability>1</Flammability>
			<Beauty>-10</Beauty>
			<Cleanliness>-3</Cleanliness>
			<TrapMeleeDamage>23</TrapMeleeDamage>
			<TrapSpringChance>1.0</TrapSpringChance>
		</statBases>
		<size>(1,1)</size>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>45</costStuffCount>
		<costList>
			<ComponentIndustrial>1</ComponentIndustrial>
		</costList>
		<building>
			<isTrap>true</isTrap>
			<trapDestroyOnSpring>true</trapDestroyOnSpring>
			<trapDamageCategory>Sharp</trapDamageCategory>
			<expandHomeArea>false</expandHomeArea>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<constructionSkillPrerequisite>4</constructionSkillPrerequisite>
		<researchPrerequisites>
		  <li>ABYautja_Tech_T2</li>
		</researchPrerequisites>
		<comps>
			<li Class="VFESecurity.CompProperties_Rearmable" MayRequire="vanillaexpanded.vfesecurity">
				<initiallyArmed>true</initiallyArmed>
				<unarmedGraphicData>
					<texPath>Things/Buildings/Security/Yautja_CutClamp_Trap_Triggered</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(1.2,1.2)</drawSize>
					<drawOffset>(0,0,0.1)</drawOffset>
				</unarmedGraphicData>
				<workToRearm>200</workToRearm>
				<rearmSound>TrapArm</rearmSound>
			</li>
		</comps>
	</ThingDef>
</Defs>