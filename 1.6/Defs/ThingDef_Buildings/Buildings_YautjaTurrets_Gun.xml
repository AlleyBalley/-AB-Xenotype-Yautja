<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BaseWeaponTurret">
		<defName>ABYautja_PredGun</defName>
		<label>pred-gun</label>
		<description>A yautja plasma turret, similar in function to the plasmacaster. Requires steel to refurbish its barrel after heavy use. May explode when damaged. Its dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
		<graphicData>
			<texPath>Things/Buildings/Security/Yautja_PredGun_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<AccuracyTouch>0.87</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.65</AccuracyMedium>
			<AccuracyLong>0.48</AccuracyLong>
			<RangedWeapon_Cooldown>2.8</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>5</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<defaultProjectile>ABBullet_YautjaTurret</defaultProjectile>
				<warmupTime>0</warmupTime>
				<range>32</range>
				<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
				<burstShotCount>2</burstShotCount>
				<soundCast>ABShot_ShoulderCannon</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>0</muzzleFlashScale>
				<consumeFuelPerShot>1</consumeFuelPerShot>
			</li>
		</verbs>
	</ThingDef>
	
	<ThingDef ParentName="BaseWeaponTurret">
		<defName>ABYautja_Fireliner</defName>
		<label>fireliner</label>
		<description>A fast firing yautja plasma turret, similar in function to the blazer. Requires steel to refurbish its barrel after heavy use. May explode when damaged. Its dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
		<graphicData>
			<texPath>Things/Buildings/Security/Yautja_Fireliner_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<AccuracyTouch>0.97</AccuracyTouch>
			<AccuracyShort>0.9</AccuracyShort>
			<AccuracyMedium>0.86</AccuracyMedium>
			<AccuracyLong>0.4</AccuracyLong>
			<RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>5</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<defaultProjectile>ABBullet_YautjaFirelinerTurret</defaultProjectile>
				<warmupTime>0</warmupTime>
				<range>35.9</range>
				<ticksBetweenBurstShots>11</ticksBetweenBurstShots>
				<burstShotCount>4</burstShotCount>
				<soundCast>ABShot_ShoulderCannon</soundCast>
				<soundCastTail>GunTail_Light</soundCastTail>
				<muzzleFlashScale>0</muzzleFlashScale>
				<consumeFuelPerShot>2</consumeFuelPerShot>
			</li>
		</verbs>
	</ThingDef>

	<ThingDef ParentName="BaseWeaponTurret">
		<defName>ABYautja_Heavy_PredGun</defName>
		<label>heavy pred-gun</label>
		<description>A heavy automatic turret. Its large plasma charges do heavy damage over significant ranges, but its barrel must be refurbished after use. It cannot fire at close-up targets, and may explode when damaged.</description>
		<graphicData>
			<texPath>Things/Buildings/Security/Yautja_HeavyPredGun_Top</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<AccuracyTouch>0.48</AccuracyTouch>
			<AccuracyShort>0.92</AccuracyShort>
			<AccuracyMedium>0.76</AccuracyMedium>
			<AccuracyLong>0.8</AccuracyLong>
			<RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Mass>40</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<defaultProjectile>Bullet_YautjaPlasmaCannonBullet</defaultProjectile>
				<warmupTime>0</warmupTime>
				<minRange>5.3</minRange>
				<range>45.9</range>
				<ticksBetweenBurstShots>12</ticksBetweenBurstShots>
				<burstShotCount>1</burstShotCount>
				<soundCast>ABShot_ShoulderCannon</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>0</muzzleFlashScale>
				<consumeFuelPerShot>1</consumeFuelPerShot>
			</li>
		</verbs>
	</ThingDef>
</Defs>