<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<HediffDef ParentName="GauntletModuleHediffBase_Combat">
		<defName>ABYautja_WristbladeLauncher</defName>
		<label>wristblade harpoon</label>
		<description>A sharp blade loaded with a spring mechanism, so that it launches itself forward.</description>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_WristbladeLauncher</ThingDef>
			<ThingDef>ABYautja_Wristblade</ThingDef>
			<RecipeDef>ABYautja_InstallWristbladeLauncher</RecipeDef>
		</descriptionHyperlinks>
		<comps>
			<li Class="MVCF.Comps.HediffCompProperties_ExtendedVerbGiver">
				<verbs>
					<li>
						<verbClass>Verb_Shoot</verbClass>
						<label>wristblade launcher</label>
						<hasStandardCommand>true</hasStandardCommand>
						<defaultProjectile>Gauntlet_WristbladeLauncher</defaultProjectile>
						<warmupTime>0.2</warmupTime>
						<range>30</range>
						<soundCast>Shot_NeedleGun</soundCast>
						<onlyManualCast>true</onlyManualCast>
						<targetParams>
							<canTargetLocations>false</canTargetLocations>
						</targetParams>
						<muzzleFlashScale>0</muzzleFlashScale>
					</li>
				</verbs>
				<verbProps>
					<li>
						<label>wristblade launcher</label>
						<canBeToggled>true</canBeToggled>
						<separateToggle>true</separateToggle>
						<toggleLabel>Automatic Firing</toggleLabel>
						<toggleIconPath>UI/Commands/Attack</toggleIconPath>
						 <comps>
							<li Class="MVCF.VerbComps.VerbCompProperties_Cooldown">
								<compClass>MVCF.VerbComps.VerbComp_Cooldown</compClass>
								<cooldownTime>3</cooldownTime>
							</li>
							<li Class="MVCF.Reloading.Comps.VerbCompProperties_Reloadable">
								<compClass>MVCF.Reloading.Comps.VerbComp_Reloadable</compClass>
								<AmmoFilter>
									<thingDefs>
										<li>ABYautja_Wristblade</li>
									</thingDefs>
								</AmmoFilter>
								<ItemsPerShot>1</ItemsPerShot>
								<MaxShots>5</MaxShots>
								<ReloadTimePerShot>2.5</ReloadTimePerShot>
							</li>
						</comps>
					</li>
				</verbProps>
			</li>
		</comps>
		<spawnThingOnRemoved>ABYautja_WristbladeLauncher</spawnThingOnRemoved>
	</HediffDef>
	
