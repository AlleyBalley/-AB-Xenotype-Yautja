		<label>Disable Yautja Tutorial pop-ups</label>
		<operations>
			<li Class="PatchOperationRemove">
				<xpath>Defs/ConceptDef[defName="ABConcept_Ranged" or defName="ABConcept_Melee" or defName="ABConcept_WristBlades" or defName="ABConcept_Gauntlet" or defName="ABConcept_YautjaComponents" or defName="ABConcept_Cloak" or defName="ABConcept_Plasmacaster"]</xpath>
