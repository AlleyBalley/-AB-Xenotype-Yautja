<Defs>

<!--Dual Wristblades-->
	<RecipeDef ParentName="GauntletModuleInstall">
		<defName>ABYautja_InstallDualWristblades</defName>
		<label>install dual wristblades</label>
		<description>Install dual wristblades.</description>
		<jobString>installing wristblades.</jobString>
		<incompatibleWithHediffTags>
			<li>GauntletModuleTag_Blade</li>
		</incompatibleWithHediffTags>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_DualWristblades</ThingDef>
			<HediffDef>ABYautja_DualWristblades</HediffDef>
		</descriptionHyperlinks>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ABYautja_DualWristblades</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ABYautja_DualWristblades</li>
			</thingDefs>
		</fixedIngredientFilter>
		<addsHediff>ABYautja_DualWristblades</addsHediff>
		<uiIconThing>ABYautja_Wristblade</uiIconThing>
	</RecipeDef>
	
