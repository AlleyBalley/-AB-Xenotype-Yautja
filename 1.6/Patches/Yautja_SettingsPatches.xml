								</li>
							</pawnKindEntries>
							<factionDefs>
								<li>ABYautja_PlayerUnblooded</li> 
							</factionDefs>
						</li>
						<li>
							<pawnKindEntries>
								<li>
									<kindDefs>
										<li>Colonist_ABYautja_Blooded</li>
									</kindDefs>
