<Defs>

	<RecipeDef ParentName="WristBladeInstallImplantBase">
		<defName>ABYautja_InstallTribalGauntlet</defName>
		<label>Install wooden gauntlet</label>
		<description>Install a wooden gauntlet.</description>
		<jobString>installing gauntlet.</jobString>
		<incompatibleWithHediffTags>
			<li>GauntletTag</li>
		</incompatibleWithHediffTags>
		<descriptionHyperlinks>
			<ThingDef>ABYautja_TribalGauntlet</ThingDef>
			<HediffDef>ABYautja_TribalGauntlet</HediffDef>
		</descriptionHyperlinks>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>ABYautja_TribalGauntlet</li>
					</thingDefs>
				</filter>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>ABYautja_TribalGauntlet</li>
			</thingDefs>
		</fixedIngredientFilter>
		<appliedOnFixedBodyParts>
			<li>ABYautja_Forearm</li>
		</appliedOnFixedBodyParts>
		<addsHediff>ABYautja_TribalGauntlet</addsHediff>
		<uiIconThing>ABYautja_TribalGauntlet</uiIconThing>
	</RecipeDef>
	
