		</statBases>
	</ThingDef>
	
	<ThingDef ParentName="CombineMultipleWristblades_Base">
		<defName>ABYautja_ClawWristblades</defName>
		<label>claw wristblades</label>
		<description>A quintet of semi-retractable blades, ready to be attached to a gauntlet. Four of the blades are attached to the front of the gauntlet to act like fingers, while a smaller wristblade is mounted to the side to act like a thumb. While the main 4 blades have a point of articulation, similar to a prehensile wristblade, they are much too oversized to help with fine motor control.</description>
		<descriptionHyperlinks>
			<HediffDef>ABYautja_ClawWristblades</HediffDef>
			<RecipeDef>ABYautja_InstallClawWristblades</RecipeDef>
		</descriptionHyperlinks>
		<graphicData>
			<texPath>Things/Item/Yautja/ClawWristblade</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<WorkToMake>50</WorkToMake>
			<MarketValue>43</MarketValue>
			<Mass>1.2</Mass>
		</statBases>
	</ThingDef>

