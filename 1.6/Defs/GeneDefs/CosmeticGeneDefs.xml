							<fat>Things/Pawn/Humanlike/BodyAttachments/Cardiovascular/GreenVisibleVeins_BodyFat</fat>
						</li>
					</ageGraphics>
					<overrideMeshSize>(1.6, 1.6)</overrideMeshSize>
					<parentTagDef>Body</parentTagDef>
					<rotDrawMode>Fresh,Rotting</rotDrawMode>
					<color>(255, 255, 255)</color>
					<visibleFacing>
						<li>East</li>
						<li>North</li>
						<li>South</li>
						<li>West</li>
					</visibleFacing>
					<baseLayer>-2</baseLayer>
					<drawData>
						<scaleOffsetByBodySize>true</scaleOffsetByBodySize>
						<bodyTypeScales>
							<Female>0.95</Female>
							<Thin>1.21</Thin>
							<Hulk>0.82</Hulk>
							<Fat>0.78</Fat>
							<Child>1.12</Child>
							<Baby>1.12</Baby>
						</bodyTypeScales>
					</drawData>
				</li>
			</renderNodeProperties>
			<exclusionTags>
				<li>VisibleCardiovascular</li>
			</exclusionTags>
			<modExtensions>
				<li Class="VEF.Genes.GeneExtension">
					<backgroundPathEndogenes>UI/Icons/Genes/Yautja_Endogene_Background</backgroundPathEndogenes>
				</li>
			</modExtensions>
