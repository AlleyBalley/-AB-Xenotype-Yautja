			<li Class="VEF.Genes.GeneExtension">
				<backgroundPathEndogenes>UI/Icons/Genes/Yautja_Endogene_Background</backgroundPathEndogenes>
			</li>
		</modExtensions>
	</GeneDef>
	
	<GeneDef>
		<defName>ABPredalienLeatherySkin</defName>
		<label>leathery skin (hediff no body)</label>
		<labelShortAdj>leathery skin</labelShortAdj>
		<description>The skin is thick and leathery, forming a hearty barrier between you and the outside world. The small scales that pepper the skin aid you in damage resistance. This version only adds the hediff of leathery skin and does not alter the body graphic at all.</description>
		<biostatCpx>1</biostatCpx>
		<biostatMet>-1</biostatMet>
		<customEffectDescriptions>
			<li>Armor against Blunt 40</li>
			<li>Armor against Sharp 20</li>
		</customEffectDescriptions>
		<displayCategory>ABYautjaCategory</displayCategory>
		<displayOrderInCategory>401</displayOrderInCategory>
		<missingGeneRomanceChanceFactor>1</missingGeneRomanceChanceFactor>
		<iconPath>UI/Icons/Genes/GeneIcon_YautjaLeatherySkin</iconPath>
		<exclusionTags>
			<li>Armor</li>
			<li>Armour</li>
			<li>Skin</li>
			<li>Scale</li>
			<li>Scales</li>
		</exclusionTags>
		<symbolPack>
			<prefixSymbols>
				<li>
					<symbol>scale</symbol>
				</li>
				<li>
					<symbol>leather</symbol>
				</li>
				<li>
					<symbol>yautja</symbol>
				</li>
			</prefixSymbols>
		</symbolPack>
		<painFactor>0.75</painFactor>
		<statOffsets>
		<Flammability>-0.1</Flammability>
		</statOffsets>
		<statFactors>
			<PainShockThreshold>1.15</PainShockThreshold>
		</statFactors>
		<modExtensions MayRequire="oskarpotocki.vanillafactionsexpanded.core">
			<li Class="VEF.Genes.GeneExtension">
				<backgroundPathEndogenes>UI/Icons/Genes/Yautja_Endogene_Background</backgroundPathEndogenes>
				<hediffToWholeBody>ABYautjaLeatherySkin</hediffToWholeBody>
			</li>
		</modExtensions>
	</GeneDef>	
	
