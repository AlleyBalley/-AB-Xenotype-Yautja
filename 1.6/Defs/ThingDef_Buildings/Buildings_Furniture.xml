<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="SleepingSpotBase">
		<defName>ABYautjaBigBabySleepingSpot</defName>
		<label>big baby sleeping spot</label>
		<description>Designates a spot on the ground where people should leave a big baby. Not comfortable. This sleeping spot is bigger than the average one, allowing for bigger babies to rest in it.</description>
		<graphicData>
			<texPath>Things/Building/Childcare/BabySleepSpot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2.5,2.5)</drawSize>
		</graphicData>
		<designationCategory>Furniture</designationCategory>
		<size>(1,1)</size>
		<building>
			<bed_maxBodySize>0.35</bed_maxBodySize>
			<bed_DisplayOwnerType>false</bed_DisplayOwnerType>
		</building>
	</ThingDef>

	<ThingDef ParentName="SansComfortBedBase">
		<defName>ABYautjaBigCrib</defName>
		<label>big crib</label>
		<description>A big cozy bed with safe latticed sides, perfect for a sleepy baby. A high quality crib will make a baby happy. Multiple cribs can be placed in a bedroom without turning it into a barracks. This crib is bigger than the average crib, allowing for bigger babies to rest in it.</description>
		<comps>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li MayRequire="Ludeon.RimWorld.Ideology">SleepAccelerator</li>
				</linkableFacilities>
			</li>
			<li Class="BigAndSmall.CompProperties_Bed" MayRequire="RedMattis.BSFurniture">
				<sleepingSlotCount>1</sleepingSlotCount>
			</li>
		</comps>
		<graphicData>
			<texPath>Things/Building/Childcare/Crib/Crib</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>2.7</drawSize>
			<shadowData>
				<volume>(0.8,0.4,0.9)</volume>
			</shadowData>
		</graphicData>
		<designationCategory>Furniture</designationCategory>
		<staticSunShadowHeight>0</staticSunShadowHeight>
		<statBases>
			<BirthRitualQualityOffset MayRequire="Ludeon.RimWorld.Biotech">0</BirthRitualQualityOffset>
			<MaxHitPoints>65</MaxHitPoints>
			<Beauty>1</Beauty>
			<WorkToBuild>400</WorkToBuild>
			<Mass>15</Mass>
			<BedRestEffectiveness>1</BedRestEffectiveness>
		</statBases>
		<size>(1,1)</size>
		<costStuffCount>25</costStuffCount>
		<uiOrder>2022</uiOrder>
		<building>
			<bed_maxBodySize>0.35</bed_maxBodySize>
			<bed_showSleeperBody>True</bed_showSleeperBody>
			<bed_emptyCountsForBarracks>false</bed_emptyCountsForBarracks>
			<bed_crib>True</bed_crib>
			<bed_pawnDrawOffset>-0.1</bed_pawnDrawOffset>
			<bed_DisplayOwnerType>false</bed_DisplayOwnerType>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites Inherit="False" />
	</ThingDef>
	
	<ThingDef ParentName="SleepingSpotBase">
		<defName>ABYautjaTitanBabySleepingSpot</defName>
		<label>titan baby sleeping spot</label>
		<description>Designates a spot on the ground where people should leave a titanic baby. Not comfortable. This sleeping spot is larger than the big one, allowing for larger babies to rest in it.</description>
		<graphicData>
			<texPath>Things/Building/Childcare/BabySleepSpot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<designationCategory>Furniture</designationCategory>
		<size>(1,1)</size>
		<building>
			<bed_maxBodySize>0.5</bed_maxBodySize>
			<bed_DisplayOwnerType>false</bed_DisplayOwnerType>
		</building>
	</ThingDef>

	<ThingDef ParentName="SansComfortBedBase">
		<defName>ABYautjaTitanCrib</defName>
		<label>titan crib</label>
		<description>A titanic cozy bed with safe latticed sides, perfect for a sleepy baby. A high quality crib will make a baby happy. Multiple cribs can be placed in a bedroom without turning it into a barracks. This crib is larger than the average crib, allowing for larger babies to rest in it.</description>
		<comps>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li MayRequire="Ludeon.RimWorld.Ideology">SleepAccelerator</li>
				</linkableFacilities>
			</li>
			<li Class="BigAndSmall.CompProperties_Bed" MayRequire="RedMattis.BSFurniture">
				<sleepingSlotCount>1</sleepingSlotCount>
			</li>
		</comps>
		<graphicData>
			<texPath>Things/Building/Childcare/Crib/Crib</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>4.7</drawSize>
			<shadowData>
				<volume>(1.7,0.7,1.77)</volume>
			</shadowData>
		</graphicData>
		<designationCategory>Furniture</designationCategory>
		<staticSunShadowHeight>0</staticSunShadowHeight>
		<statBases>
			<BirthRitualQualityOffset MayRequire="Ludeon.RimWorld.Biotech">0</BirthRitualQualityOffset>
			<MaxHitPoints>75</MaxHitPoints>
			<Beauty>1</Beauty>
			<WorkToBuild>400</WorkToBuild>
			<Mass>20</Mass>
			<BedRestEffectiveness>1</BedRestEffectiveness>
		</statBases>
		<size>(2,2)</size>
		<costStuffCount>30</costStuffCount>
		<uiOrder>2022</uiOrder>
		<building>
			<bed_maxBodySize>0.55</bed_maxBodySize>
			<bed_showSleeperBody>True</bed_showSleeperBody>
			<bed_emptyCountsForBarracks>false</bed_emptyCountsForBarracks>
			<bed_crib>True</bed_crib>
			<bed_pawnDrawOffset>0.15</bed_pawnDrawOffset>
			<bed_DisplayOwnerType>false</bed_DisplayOwnerType>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites Inherit="False" />
	</ThingDef>
</Defs>